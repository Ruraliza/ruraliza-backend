{
  // Build de produção: só a API (sem scripts de teste) para dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  "include": ["app.ts", "src/**/*.ts"],
  // Testes unitários (e as fixtures em testing/) ficam ao lado do código, mas não vão para dist/.
  "exclude": ["src/**/*.spec.ts", "src/**/testing/**"]
}
