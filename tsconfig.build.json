{
  // Build de produção: só a API (sem scripts de teste) para dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  "include": ["app.ts", "src/**/*.ts"],
  // Testes unitários ficam ao lado dos casos de uso, mas não vão para dist/.
  "exclude": ["src/**/*.spec.ts", "src/shared/testing/**"]
}
