# Configuração do backend do Ruraliza.
# Copie este arquivo para `.env` (que NÃO vai para o git) e preencha os valores:
#   cp .env.example .env
# Em produção (Render), cadastre as mesmas variáveis em Environment > Environment Variables.

# Porta do servidor (padrão 3000).
PORT=3000

# Origens (separadas por vírgula) que podem chamar a API pelo navegador e obter a chave do mapa.
# Sem esta variável, só o frontend publicado (https://ruraliza.github.io) é aceito.
# Em `npm run dev` as demais rotas aceitam qualquer origem; a do mapa segue esta lista.
# Em produção (Render), NÃO defina; no .env local, libere o Angular em desenvolvimento:
CORS_ORIGINS=http://localhost:4200

# --- Google Maps Platform ---------------------------------------------------
# Usado no cadastro/edição de fazendas (mapa com alfinete e localização atual)
# e no mapa da fazenda mostrado ao trabalhador aceito no serviço.
#
# 1. Abra https://console.cloud.google.com/google/maps-apis/credentials
# 2. Em "APIs e serviços", habilite: "Maps JavaScript API", "Geocoding API" e "Maps Embed API".
#    (A Embed API, usada nos mapas só de leitura, é gratuita e ilimitada.)
# 3. Cole a chave em GOOGLE_MAPS_API_KEY.
# 4. Restrinja a chave (ela é entregue ao navegador pelo GET /api/config/maps):
#    - Restrição de aplicativo: "Sites" (HTTP referrers), com
#        http://localhost:4200/*
#        e o domínio onde o frontend está publicado (ex.: https://<usuario>.github.io/*)
#    - Restrição de API: só "Maps JavaScript API", "Geocoding API" e "Maps Embed API".
# 5. Plano gratuito (10 mil/mês por API): em Cotas, limite "Map loads per day" (Maps JavaScript)
#    e "Requests per day" (Geocoding) a 300 cada. Alerta de orçamento só avisa; a cota bloqueia.
#    Quem não está mexendo no mapa pode deixar a chave vazia no .env local.
# Sem a chave, GET /api/config/maps responde 503 e o mapa fica indisponível no frontend.
GOOGLE_MAPS_API_KEY=

# Map ID (necessário para o alfinete arrastável, o "Advanced Marker").
# Crie um em https://console.cloud.google.com/google/maps-apis/studio/maps
# (tipo "JavaScript", renderização "Vetor") ou use DEMO_MAP_ID em desenvolvimento.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Notificações push (Web Push) ---------------------------------------------
# Avisam produtor e trabalhador de candidaturas, aceites, recusas, cancelamentos e pagamentos
# mesmo com o app fechado. Gere o par de chaves uma vez e guarde as duas:
#   npx web-push generate-vapid-keys
# A pública vai para o navegador por GET /api/config/push; a privada NUNCA sai do servidor.
# Trocar as chaves invalida todas as inscrições (cada pessoa precisa ativar de novo).
# Sem as chaves, GET /api/config/push responde 503 e nada é enviado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato de quem envia (mailto: ou https:), exigido pelos serviços de push.
VAPID_SUBJECT=mailto:contato@ruraliza.app

# --- Avisos por WhatsApp (Evolution API v2) -----------------------------------
# Quem liga "Avisos no WhatsApp" no perfil recebe no celular os avisos importantes (hoje: candidatura aceita).
# Precisa de um servidor da Evolution API (open source) com um número de WhatsApp conectado:
#   https://doc.evolution-api.com  ->  crie uma instância, conecte o número pelo QR code e copie a API key.
# As três variáveis juntas ligam o envio; sem elas, nada sai (o resto do app funciona igual).
# Para Z-API, Twilio ou a API oficial da Meta, escreva outro WhatsAppSender (src/modules/notifications/domain/whatsapp.ts).
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=
# Endereço do frontend usado nos links das mensagens (padrão: https://ruraliza.github.io/ruraliza-frontend).
APP_URL=

# --- Sessão --------------------------------------------------------------------
# Segredo que assina os tokens de sessão (Authorization: Bearer). Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sem ele, o servidor usa um segredo temporário e todas as sessões caem a cada reinício.
# Trocar o segredo desconecta todo mundo. Em produção (Render), DEFINA.
AUTH_TOKEN_SECRET=

# --- Primeiro administrador ----------------------------------------------------
# Usuários de sistema não se cadastram pelo app. Com estas variáveis, o servidor cria o
# administrador ao subir (se o e-mail ainda não existir; senha de 8 a 128 caracteres).
# Os demais usuários de sistema (administradores e tutores) são criados por ele em /sistema/equipe.
# Em desenvolvimento (npm run dev), o seed já cria admin@exemplo.com com a senha ruraliza123.
# Em produção (npm start) não há seed: estas variáveis são a única forma de a equipe entrar. No Render, DEFINA.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- Seed de demonstração --------------------------------------------------------
# O seed (contas de teste com a senha pública ruraliza123 do README) só roda no npm run dev (--dev).
# SEED_DEMO=true liga o seed também no npm start, só para um ambiente de demonstração.
# Nunca ligue onde houver dados de verdade.
SEED_DEMO=
