# Configuração do backend do Ruraliza.
# Copie este arquivo para `.env` (que NÃO vai para o git) e preencha os valores:
#   cp .env.example .env
# Em produção (Render), cadastre as mesmas variáveis em Environment > Environment Variables.

# Porta do servidor (padrão 3000).
PORT=3000

# --- Google Maps Platform ---------------------------------------------------
# Usado no cadastro/edição de fazendas (mapa com alfinete e localização atual)
# e no mapa da fazenda mostrado ao trabalhador aceito no serviço.
#
# 1. Abra https://console.cloud.google.com/google/maps-apis/credentials
# 2. Em "APIs e serviços", habilite: "Maps JavaScript API" e "Geocoding API".
# 3. Cole a chave em GOOGLE_MAPS_API_KEY.
# 4. Restrinja a chave (ela é entregue ao navegador pelo GET /api/config/maps):
#    - Restrição de aplicativo: "Sites" (HTTP referrers), com
#        http://localhost:4200/*
#        e o domínio onde o frontend está publicado (ex.: https://<usuario>.github.io/*)
#    - Restrição de API: só "Maps JavaScript API" e "Geocoding API".
# Sem a chave, GET /api/config/maps responde 503 e o mapa fica indisponível no frontend.
GOOGLE_MAPS_API_KEY=

# Map ID (necessário para o alfinete arrastável, o "Advanced Marker").
# Crie um em https://console.cloud.google.com/google/maps-apis/studio/maps
# (tipo "JavaScript", renderização "Vetor") ou use DEMO_MAP_ID em desenvolvimento.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
